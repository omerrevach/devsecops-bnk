# Settings for `make up`. Copy to lab.env (git-ignored) and adjust:  cp lab.env.example lab.env
# Nothing secret goes here: passwords and tokens are generated during setup and kept in AWS Parameter Store.

# AWS CLI profile with rights to build the lab (see scripts/create-lab-user.sh), and the region to use.
AWS_PROFILE=bank-lab
AWS_REGION=eu-central-1

# Name prefix for every AWS resource (3-15 lowercase letters, digits or dashes).
# The Terraform state bucket is <PROJECT>-tfstate-<account id>.
PROJECT=bank-lab

# AWS Client VPN, for opening GitLab and Harbor in your browser (~$0.10/h, more while connected).
# Not needed for `make up` itself: setup runs through SSM.
ENABLE_CLIENT_VPN=true

# auto: make up plays the whole demo by itself (scripted approvals).
# manual: make up stops after the first pipeline starts; you do the demo in the web UIs
#         (README, "Run the demo yourself"). make demo-reset gives you a fresh project to do it again.
DEMO=auto
